# Minecraft YouTube Shorts AI Pipeline Configuration
# Put your Gemini API Key here (Free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (gemini-3.5-flash-lite is recommended)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Groq Whisper API Key (Free from https://console.groq.com)
GROQ_API_KEY=
